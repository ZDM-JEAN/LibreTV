{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "libretv-workers-preview",
  // Publish the password-protected production Worker on its workers.dev URL.
  "workers_dev": true,
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // A Workers Free request has a 50 external-subrequest limit. One search page
  // per source keeps a 28-source aggregate below that limit with room for redirects.
  "vars": {
    "SEARCH_MAX_PAGES": "1"
  },
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
