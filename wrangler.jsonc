{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "libretv-workers-preview",
  // Keep the candidate private until the PASSWORD secret is configured.
  "workers_dev": false,
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
